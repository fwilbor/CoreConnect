# Copy to .env.local for development. In Vercel, set these per environment.

# Supabase project (Settings > API). Publishable and secret keys; the legacy
# anon and service_role keys also work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Postgres connection used by server code (Settings > Database > Connection
# pooling, transaction mode, port 6543). Locally: a database built by
# `pnpm db:reset`, e.g. postgres://postgres@localhost:5432/coreconnect_dev
DATABASE_URL=postgres://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Fallback origin for auth links when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile). These are Cloudflare's
# always-pass test keys for development; use real keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Random 32+ byte secret for hashing IP addresses: `openssl rand -hex 32`
IP_HASH_SECRET=
