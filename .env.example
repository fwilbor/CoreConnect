# Copy to .env.local for development. In Vercel, set these per environment.

# Supabase project (Settings > API). Publishable and secret keys; the legacy
# anon and service_role keys also work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Postgres connection used by server code (Settings > Database > Connection
# pooling, transaction mode, port 6543). Locally: a database built by
# `pnpm db:reset`, e.g. postgres://postgres@localhost:5432/coreconnect_dev
DATABASE_URL=postgres://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Fallback origin for auth links when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile). These are Cloudflare's
# always-pass test keys for development; use real keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Random 32+ byte secret for hashing IP addresses: `openssl rand -hex 32`
IP_HASH_SECRET=

# Signs public links (unsubscribe, application, deposit): `openssl rand -hex 32`.
# Keep it stable; changing it breaks links in emails already sent.
APP_TOKEN_SECRET=
# Protects /api/jobs/tick (called every minute by Vercel Cron, or `pnpm jobs:dev`).
CRON_SECRET=

# Email via Resend (resend.com). Without RESEND_API_KEY emails are only logged.
RESEND_API_KEY=
# Shared sending domain verified in Resend; mail goes out as "<Business>" <slug@EMAIL_FROM_DOMAIN>.
EMAIL_FROM_DOMAIN=
# Optional override for every sender, e.g. onboarding@resend.dev while testing without a domain.
EMAIL_FROM=
# Signing secret for Resend webhooks -> /api/webhooks/email/events
RESEND_WEBHOOK_SECRET=
# Optional: domain whose inbound mail is routed to the app, so replies thread onto leads.
EMAIL_REPLY_DOMAIN=

# Twilio. Without these, texts are only logged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Stripe platform account with Connect enabled (Standard accounts).
STRIPE_SECRET_KEY=
# Webhook signing secret for /api/webhooks/stripe (listen to Connect events too).
# Locally: `stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired,charge.refunded,account.updated --forward-to localhost:3000/api/webhooks/stripe --forward-connect-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# Shown on the CoreConnect privacy policy and terms (/privacy, /terms). Until set,
# the pages show bracketed placeholders.
LEGAL_COMPANY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_MAILING_ADDRESS=
LEGAL_GOVERNING_STATE=

# Sentry error reporting and the job-tick cron monitor. Leave empty to turn off.
# Use the same DSN for both. Source map upload (optional) also needs the last three.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Inbound email (Resend receiving). EMAIL_INBOUND_DOMAIN: domain whose mail
# Resend receives (MX record) for forwarded inquiries, <slug>@domain (FR-04).
# Replies thread onto leads at reply+<token>@EMAIL_REPLY_DOMAIN (can be the same
# domain). Point a Resend "email.received" webhook at /api/webhooks/email/inbound;
# its signing secret goes here (falls back to RESEND_WEBHOOK_SECRET).
EMAIL_INBOUND_DOMAIN=
RESEND_INBOUND_WEBHOOK_SECRET=

# Set to true once Supabase sends auth email through Resend SMTP with the
# templates in supabase/templates (see [auth.email.smtp] in supabase/config.toml):
# the sign-in page then offers the 8-digit code from the email.
AUTH_EMAIL_HAS_CODE=
# Sender for sign-in and invite emails, read by `supabase config push`.
AUTH_EMAIL_FROM=
